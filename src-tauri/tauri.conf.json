{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Typst Studio",
  "version": "0.1.0",
  "identifier": "app.typst.studio",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Typst Studio",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A desktop editor for Typst documents.",
    "longDescription": "Typst Studio is a desktop editor for the Typst typesetting system, with live preview, completion, and export to PDF, PNG, and SVG.",
    "copyright": "Copyright (c) 2026 Typst Studio contributors",
    "publisher": "Typst Studio",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}